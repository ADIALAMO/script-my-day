# FAKE values for the local integration suite. Nothing here is a real credential; the suite never
# reads your real environment (it purges process.env first) and never calls a real service.
NEXTAUTH_SECRET=integration-test-nextauth-secret-not-real-0123456789
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://site.test

UPSTASH_REDIS_REST_TOKEN=fake-upstash-token
# UPSTASH_REDIS_REST_URL is injected by setup.mjs (points at the in-process fake on 127.0.0.1)

GOOGLE_GEMINI_API_KEY=fake-gemini-key
OPENROUTER_API_KEY=fake-openrouter-key
OPENROUTER_FREE_KEY=fake-openrouter-free-key
COHERE_API_KEY=fake-cohere-key
CLOUDFLARE_ACCOUNT_ID=fakeaccount0000000000000000000000
CLOUDFLARE_API_TOKEN=fake-cloudflare-token
R2_ACCESS_KEY_ID=fake-r2-key-id
R2_SECRET_ACCESS_KEY=fake-r2-secret
R2_BUCKET_NAME=test-bucket
R2_PUBLIC_URL=https://pub-test.r2.dev

STRIPE_SECRET_KEY=sk_test_fake_not_a_real_key
STRIPE_WEBHOOK_SECRET=whsec_fake_not_a_real_secret

EMAIL_SERVER_HOST=smtp.test.invalid
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=fake-user
EMAIL_SERVER_PASSWORD=fake-password
EMAIL_FROM=LifeScript Test <noreply@test.invalid>

GOOGLE_CLIENT_ID=fake-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=fake-google-client-secret

TELEGRAM_BOT_TOKEN=000000:fake-telegram-token
TELEGRAM_CHAT_ID=1

ADMIN_SECRET=fake-admin-secret
ADMIN_EMAILS=admin@test.example
PRO_ALLOWLIST=vip@test.example
