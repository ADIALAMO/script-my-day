# ── AI Providers ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=                  # Primary paid key — stages 2 & 4 (Gemma, DeepSeek)
# OPENROUTER_FREE_KEY was REMOVED from every environment (owner, 2026-10-27). The code still reads it if set, but without it script Stage 5 and the free
# storyboard models are simply skipped (one startup warning, no error). tools/quality-eval's `:free` model needs it and would get a 401 without it.

GOOGLE_GEMINI_API_KEY=               # Stage 1 (Gemini flash models race)
GEMINI_API_KEY=                      # Alias used by some routes — keep in sync with above
# EVAL_GOOGLE_API_KEY=                # Benchmark only (tools/quality-eval) — a separate key, never the production key

COHERE_API_KEY=                      # Stage 3 (Cohere Command R+)
HF_TOKEN=                            # Hugging Face — image generation pipeline
HF_PROVIDER_ENABLED=                 # 'true' to include HF in the image cascade — defaults to
                                      # disabled: hf-inference's FLUX.1-schnell route returns a
                                      # permanent HTTP 410 as of ~July 2026 (confirmed via HF's own
                                      # forum, model pulled, won't self-heal). Flip this on only
                                      # after swapping runHuggingFace to a confirmed-working model.

# ── Cloudflare R2 (image / asset storage) ─────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
OBJECT_KEY_SECRET=                    # REQUIRED in production AND preview deployments; keep it stable and back it up. Random 32+ chars; keys the owner segment of R2 object paths (HMAC). Generate: openssl rand -hex 32
R2_PUBLIC_URL=                       # Public CDN base URL for stored images
R2_QUARANTINE_BUCKET_NAME=           # PRIVATE bucket (no r2.dev URL, no custom domain, 30-day lifecycle rule) that reported images
                                     # are moved into (lib/quarantine.js). The existing R2 API token needs Object Read & Write on it.
                                     # Unset = nothing is deleted or moved: a report still hides the image in the app (proxy 410) and
                                     # the Telegram alert says the object is STILL PUBLIC and needs a manual takedown.

# ── Site URL (absolute base for OG images + invite links) ─────────────────────
NEXT_PUBLIC_SITE_URL=                 # Canonical absolute base, e.g. https://lifescript.app
                                     # MUST be a LIVE domain (crawlers fetch og:image from it).
                                     # Unset → falls back to the Vercel deployment URL so OG
                                     # previews never 404. Set to the custom domain once it's
                                     # connected, then redeploy. NEXT_PUBLIC_ = available on
                                     # server+client (no hydration mismatch) + inlined at build.

# ── Upstash Redis (quota tracking) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cost safety ───────────────────────────────────────────────────────────────
DAILY_IDENTITY_BUDGET=               # Optional USD ceiling on TOTAL "Star Yourself" spend
                                     # per UTC day. Once reached, identity degrades to the
                                     # faceless cascade (app stays up) until midnight UTC.
                                     # Unset = no cap. Worst-case cost/call assumed = $0.06.
DAILY_IMAGE_BUDGET=                  # Optional USD ceiling on TOTAL paid-faceless image spend
                                     # (OpenRouter Klein overflow when Cloudflare's free budget
                                     # is exhausted) per UTC day. Once reached, the paid provider
                                     # is dropped and the cascade uses only the free providers.
                                     # Unset = no cap. Cost/call assumed = KLEIN_COST_USD below.
# ── Paid safety checks: THREE independent daily budgets (USD per UTC day; 0 = that paid check is OFF). Exhausting one never affects the others. ──
DAILY_CHECK_BUDGET=                  # IMAGE checks: the output-image fallback (google/gemini-2.5-flash-lite THROUGH OpenRouter, same
                                     # OPENROUTER_API_KEY, provider.data_collection=deny), used when the free Nemotron checker is down,
                                     # rate-limited or unreadable. Default 0.50 (≈ 3,300 checks). 0 = fallback OFF (Nemotron-only, fail-closed).
DAILY_TEXT_CHECK_BUDGET=             # TEXT classifier on every generated script / storyboard (all genres). Default 0.30 (≈ 750 checks at the
                                     # 0.0004 upper-bound price). 0 or spent: romance/horror fail CLOSED (CONTENT_CHECK_UNAVAILABLE), every other
                                     # genre is returned on the keyword-blocklist result alone (counted in stats:textcheck:degraded:<day>).
DAILY_MINOR_CHECK_BUDGET=            # apparent-minor screen at "Star Yourself" upload. Default 0.50 (≈ 3,300 checks/day). FAIL-CLOSED: 0 or spent (or
                                     # the check is down / unreadable) = the upload is refused with PHOTO_CHECK_UNAVAILABLE (503, retryable, nothing
                                     # stored or charged). "unsure" is still accepted, a clear "minor" is MINOR_REJECTED. Not age verification.
DAILY_IMAGE_SAFETY_BUDGET=           # SECOND-OPINION image check, run after Nemotron says "safe" on every generated image (nudity / sexualized / sexualized
                                     # minor-looking). Default 0.50 (≈ 3,300 images/day). 0 or spent: images are NOT shown (CONTENT_CHECK_UNAVAILABLE,
                                     # retryable, quota returned) — fail closed. Own circuit (check_imgsafety); independent of the other three budgets.
DAILY_NEMOTRON_BUDGET=               # PRIMARY image checker: the PAID nvidia/nemotron-3.5-content-safety (DeepInfra) with provider.data_collection=deny, same OPENROUTER_API_KEY.
                                     # Default 1.00 USD/day; upper-bound price 0.0002/call (NEMOTRON_COST_USD overrides) = 5,000 checks/day (measured $0.0001468 each).
                                     # 0 or spent or not verifiable (Redis down): Nemotron is SKIPPED and the Gemini fallback (DAILY_CHECK_BUDGET) decides — fail-closed
                                     # if that is unavailable too. Counter key usage:check:nemotron:global:<day>; 80% warning + once-a-day "reached" Telegram alert.
DAILY_STORYBOARD_BUDGET=             # PAID FIRST ENGINE of the comic storyboard (google/gemini-2.5-flash-lite THROUGH OpenRouter, same OPENROUTER_API_KEY,
                                     # provider.data_collection=deny, strict json_schema). Default 1.00 (≈ 830 comics/day at the 0.0012 upper-bound price).
                                     # 0 or spent / circuit `storyboard_gemini` open: the paid engine is SKIPPED (never a failure) — the OpenRouter gemma hedge and the
                                     # fallbacks serve; the direct Google key (free tier) is only the LAST fallback. Counter key usage:storyboard:paid:global:<day>.
STORYBOARD_COST_USD=                 # optional, storyboard first-engine price per call for the cap math, default 0.0012
STORYBOARD_PRIMARY_MODEL=            # optional, OpenRouter slug of the storyboard first engine, default google/gemini-2.5-flash-lite
IMAGE_SAFETY_COST_USD=               # optional, second-opinion price per call for the cap math, default 0.00015
CHECK_COST_USD=                      # optional upper-bound price per call used for the image + (default) math, default 0.00015
TEXT_CHECK_COST_USD=                 # optional, text classifier price per call for the cap math, default 0.0004
MINOR_CHECK_COST_USD=                # optional, minor screen price per call for the cap math, default 0.00015
CRON_SECRET=                         # REQUIRED for the daily report sweep (vercel.json cron → /api/cron/sweep-hidden). Any random 32+ chars
                                     # (openssl rand -hex 32). Vercel sends it as "Authorization: Bearer <value>" to cron routes; without it the
                                     # route answers 401 and does nothing. Set it in Production (crons only run there) AND Preview.
IMAGE_CHECK_REASONING_EFFORT=        # Optional: none (default) | minimal | low | medium | high | off. Reasoning effort
                                     # sent to the Nemotron checker via OpenRouter. The probe confirmed "none" is
                                     # accepted (~5 tokens, 150-400 ms). "off" sends no reasoning option at all;
                                     # an invalid value falls back to none.
IMAGE_CHECK_FALLBACK_MODEL=          # Optional OpenRouter slug of the fallback checker
                                     # (default google/gemini-2.5-flash-lite). The check no longer needs
                                     # GOOGLE_GEMINI_API_KEY.
IMAGE_CHECK_RETRY_MODEL=             # Optional: the model of the ONE retry after an HTTP 429 on the paid Gemini checks (second opinion, text classifier, minor screen,
                                     # image fallback). UNSET = google/gemini-2.5-flash (same provider and published data policy as flash-lite, its own per-model upstream
                                     # limit, ≈ $0.00011/check, short 0.3-0.7 s jitter). SET BUT EMPTY = retry on the SAME model (then a longer 1.5-2.0 s jitter).
                                     # Only google/gemini-* slugs are accepted; anything else is ignored (warning) and the default is used.
KLEIN_COST_USD=                      # Optional override for the per-image Klein cost used by
                                     # the budget math above. Default $0.014 (flux.2-klein-4b,
                                     # verified at openrouter.ai/logs — re-check there if
                                     # OpenRouter's pricing changes; don't let this drift stale).
REFERRAL_REWARD_CAP=                 # Optional max identity credits ONE referrer can earn
                                     # via the invite loop (default 10 → ~$0.60 cap/referrer).

# ── Stripe (payments) ─────────────────────────────────────────────────────────
# Use pk_test_ / sk_test_ for local dev; pk_live_ / sk_live_ for production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Billing gate (pre-launch waitlist) ────────────────────────────────────────
# Leave false/unset while Stripe is in Test Mode: the public sees a Pro WAITLIST
# instead of the checkout, so nobody can self-unlock unlimited generation with
# the 4242 test card and burn the AI/infra budget. Flip to "true" the day Stripe
# goes Live — no code change needed.
NEXT_PUBLIC_BILLING_ENABLED=false
# Comma-separated emails that get Pro on sign-in WITHOUT Stripe (invited
# influencers / key testers). Access is bound to identity, so it can't leak like
# a shareable link would. e.g. you@example.com,creator@example.com
PRO_ALLOWLIST=

# ── Authentication (NextAuth) ─────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                     # Random 32-char secret: `openssl rand -base64 32`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (magic link auth) ───────────────────────────────────────────────────
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=               # Gmail app password (not your account password)
EMAIL_FROM=                          # e.g. "LifeScript Studio <you@gmail.com>"

# ── Telegram (admin notifications) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── App config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_SECRET=                        # Secret for admin API bypass
ADMIN_EMAILS=                        # Comma-separated admin email addresses

# ── Tunable limits (all OPTIONAL — defaults live in config/limits.js) ─────────────────
# Leave unset to use the defaults shown. Non-numeric/negative values are ignored. Server-side
# only: the browser UI (upgrade table, FAQ/terms copy) shows the defaults, so keep copy in sync
# if you override. See config/limits.js for what each one controls.
# FREE_COMICS_PER_MONTH=3
# FREE_FIRST_COMIC_PANELS=7
# FREE_LATER_COMIC_PANELS=3
# PRO_COMICS_PER_DAY=2
# PRO_COMICS_PER_MONTH=6
# GUEST_IP_RETENTION_DAYS=90  # how long the lifetime guest-poster counter (keyed by IP) is kept; refreshed on each use
# GUEST_SCRIPTS_PER_DAY=300   # global cap on guest (anonymous) scripts per UTC day; 0 = no cap
# COMIC_REGEN_LIMIT=2
# FREE_PANELS_PER_DAY=30
# PRO_PANELS_PER_DAY=30
# PRO_SCRIPTS_PER_DAY=20
# PRO_SCRIPTS_PER_MONTH=150
# SCRIPT_GEMINI_MODE=hedge            # 'hedge' (default: one call per script) | 'race' (old: 2 parallel paid calls)
# SCRIPT_GEMINI_HEDGE_MS=28000        # (effective default 27000 after the Stage-1 reserve) start the 2nd quality model only if the 1st is slower than this (clamped to fit)
# SCRIPT_GEMINI_QUALITY_BUDGET_MS=46000  # also capped at SCRIPT_TOTAL_BUDGET_MS - SCRIPT_STAGE1_RESERVE_MS
# SCRIPT_GEMINI_MIN_START_MS=15000    # the 2nd model is not started with less than this left
# SCRIPT_TOTAL_BUDGET_MS=50000        # whole script cascade; keep >= 10 s under the route maxDuration (60 s)
# SCRIPT_STAGE1_RESERVE_MS=8000       # time Gemini (Stage 1) leaves for Stages 2-5; >8 s pulls the hedge into the normal latency band
# SCRIPT_GEMMA_27B_TIMEOUT_MS=20000   # per-call ceilings of Stages 2-5 (always cut to the time left)
# SCRIPT_GEMMA_12B_TIMEOUT_MS=12000
# SCRIPT_COHERE_TIMEOUT_MS=10000
# SCRIPT_DEEPSEEK_TIMEOUT_MS=12000
# SCRIPT_FREE_TIMEOUT_MS=12000
# SCRIPT_LAST_RESORT_RESERVE_MS=6000  # Stages 2-4 leave this for Stage 5 (free model); 0 disables
# SCRIPT_CIRCUIT_ENABLED=true         # per-model circuit breaker on HTTP 429 (circuit:script:* in Redis); 'false' disables
# SCRIPT_CIRCUIT_RPM_MS=60000         # pause after a 429
# SCRIPT_CIRCUIT_ESCALATED_MS=900000  # pause after a 2nd consecutive 429 (no success in between)
# SCRIPT_GEMINI_FAST_HEDGE_MS=4000
# SHEET_UPLOADS_FREE_PER_MONTH=3
# SHEET_UPLOADS_PRO_PER_MONTH=30
# AUTH_EMAIL_PER_ADDRESS_PER_HOUR=5
# AUTH_EMAIL_PER_IP_PER_HOUR=10
# PROXY_IMAGE_PER_IP_PER_MINUTE=120
# PROXY_IMAGE_MAX_BYTES=3145728
# OG_PER_IP_PER_MINUTE=30
# OG_MAX_ASSET_BYTES=1048576

# ── Developer-only scroll debug overlay (components/ScrollDebug.jsx) ───────────────────────────────────────────
# Leave this UNSET in Production. Only when it is "true" at BUILD time (e.g. a Preview deployment) does ?debug=1 (or a stored
# {"debug":1} in localStorage `ls_variant_flags`) show the overlay; otherwise the overlay is not bundled and the flags are ignored/cleaned.
NEXT_PUBLIC_SCROLL_DEBUG=

# Script cascade: paid Gemini 2.5 Flash through OpenRouter (provider.data_collection=deny) is Stage 0. USD per UTC day; default 10; 0 = OFF = the old cascade (free Google key first).
# While > 0 the journal text goes ONLY to OpenRouter models with "deny" (Gemma, DeepSeek as fallbacks); the free Google key, Cohere and the free models are not used for scripts.
# DAILY_SCRIPT_BUDGET=10
# SCRIPT_PAID_COST_USD=0.008     # upper-bound price per call used for the cap (probe: $0.0044 English, $0.0071 Hebrew)
# SCRIPT_PAID_MODEL=google/gemini-2.5-flash
